# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy key aliases (optional, only if you are not using the keys above)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin access
ADMIN_ENTRY_SLUG=
ADMIN_ALLOWED_EMAILS=

# Contact ingestion
CONTACT_IP_SALT=

# LibreOffice WASM (same-origin only): copy `soffice.wasm`, `soffice.data`, and worker scripts
# into `public/wasm/`. Large binaries are gitignored — without them the converter cannot start.
#
# Optional: log WASM URLs once in the browser console while debugging.
# In DevTools: window.__DOCXFORM_WASM_BASE__  (always `/wasm/` after hydration).
# NEXT_PUBLIC_DEBUG_WASM=1

# Playwright e2e (`npm run test:e2e`): when `next dev` uses another port, set this to match (see playwright.config.ts).
# PLAYWRIGHT_BASE_URL=http://localhost:3001
