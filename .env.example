# ----- Production (hosting env, e.g. Cloudflare Pages → Production variables; redeploy after changes) -----

# Supabase: contact, admin, POST /api/metrics/converter
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional legacy names (lib/supabase-server.ts)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin: /api/admin/* and /{slug}/login|inbox|converter-metrics
ADMIN_ENTRY_SLUG=
ADMIN_ALLOWED_EMAILS=

# Contact form IP hashing (has default if unset)
CONTACT_IP_SALT=

# Organization JSON-LD sameAs (comma-separated URLs)
NEXT_PUBLIC_SITE_SAMEAS=

# WASM: bump when R2 soffice.{wasm,data} change (build-time path /wasm/bin/<rev>/).
# The browser caches by that URL; the client also stores this revision in localStorage after a
# successful load so optional priming and probes can skip redundant network work until you bump it.
# Same-origin builds also re-check the HTTP cache (`only-if-cached`) so clearing "cached images"
# without site data invalidates that hint and triggers a fresh download.
NEXT_PUBLIC_WASM_ASSET_REVISION=
# Post-LCP WASM priming: 0=off 1=on; prod defaults on unless set to 0
NEXT_PUBLIC_WASM_POST_LCP_PRIME=
# Optional: combined soffice.wasm + soffice.data size in bytes (digits only), preload gating
NEXT_PUBLIC_WASM_BUNDLE_BYTES=

# ----- Local / dev only (.env.local, or Preview if you want; not required for prod behavior) -----

# Alternate WASM root in dev (HTTPS, mirrors /wasm/); prod build always uses same-origin /wasm/
NEXT_PUBLIC_WASM_ASSET_BASE=
# 1 = console.debug perf tier + converter eligibility once per load
NEXT_PUBLIC_DEBUG_PERF=

# R2 upload script (scripts/upload-wasm-r2.mjs)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# R2_WASM_BUCKET=
# R2_WASM_PREFIX=wasm
# R2_PUBLIC_BASE_URL=

# Playwright, Lighthouse script, e2e perf skip, diagnose script
# PLAYWRIGHT_BASE_URL=
# LIGHTHOUSE_URL=
# PERF_SKIP_CONVERTER_WAIT=1
# WASM_DIAGNOSE_ORIGIN=
