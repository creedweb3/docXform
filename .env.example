# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy key aliases (optional, only if you are not using the keys above)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin access
ADMIN_ENTRY_SLUG=
ADMIN_ALLOWED_EMAILS=

# Contact ingestion
CONTACT_IP_SALT=

# --- LibreOffice WASM (required for Word/PDF conversion) ---
# Copy the full bundle into public/wasm/ (soffice.wasm ~140MB, soffice.data, *.js).
#
# GitHub rejects files >100MB, so production usually uses EITHER:
#   (A) NEXT_PUBLIC_WASM_ASSET_BASE=https://your-cdn.example/wasm  (must mirror filenames under /wasm/)
#       plus CORS: allow GET/HEAD from https://docxform.com, https://www.docxform.com, and dev origins.
#   (B) Git LFS for public/wasm/soffice.wasm + soffice.data (then leave base unset).
#
# Cloudflare setup (recommended): keep NEXT_PUBLIC_WASM_ASSET_BASE unset so runtime URLs stay same-origin `/wasm/`.
# Middleware proxies `/wasm/bin/<revision>/soffice.{wasm,data}` (and legacy `/wasm/soffice.*`) to your CDN; JS stays under `/public/wasm/`.
# (Default safety: production forces same-origin `/wasm/`; set NEXT_PUBLIC_WASM_FORCE_SAME_ORIGIN=0 to opt out.)
#
# Bump when shipping new WASM binaries — changes the `/wasm/bin/<revision>/` path (immutable long cache per version).
# NEXT_PUBLIC_WASM_ASSET_REVISION=2026-05-07
#
# Optional: combined byte size of soffice.wasm + soffice.data for preload ETA (digits only). Improves auto-preload gating.
# NEXT_PUBLIC_WASM_BUNDLE_BYTES=170000000
#
# Optional: log chosen perf tier + signals once per page load (browser console): NEXT_PUBLIC_DEBUG_PERF=1
#
# Optional helper env for Cloudflare R2 upload script:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=   # token with R2 write permissions
# R2_WASM_BUCKET=
# R2_WASM_PREFIX=wasm
# R2_PUBLIC_BASE_URL=https://<public-r2-domain>/wasm

# Playwright e2e: match dev port if not 3000 (see playwright.config.ts).
# PLAYWRIGHT_BASE_URL=http://localhost:3001
