# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy key aliases (optional, only if you are not using the keys above)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin access
ADMIN_ENTRY_SLUG=
ADMIN_ALLOWED_EMAILS=

# Contact ingestion
CONTACT_IP_SALT=

# Optional: serve LibreOffice WASM from Cloudflare R2 (or any HTTPS URL) instead of /public/wasm
# Example: https://pub-xxxxxxxxxxxx.r2.dev/wasm  or  https://wasm.yourdomain.com/wasm
# Leave unset for local same-origin /wasm/. Configure R2 CORS for your origins + CORP if using COEP.
# Copy `scripts/r2-cors-policy.json` into Cloudflare R2 → bucket → CORS policy (edit AllowedOrigins if needed).
# NEXT_PUBLIC_WASM_ASSET_BASE=

# Optional: on load, log WASM base + worker URL once in the browser console (set on Netlify while debugging).
# In DevTools, use: window.__DOCXFORM_WASM_BASE__  (always set after hydration on any page).
# NEXT_PUBLIC_DEBUG_WASM=1

# R2 CLI upload (npm run wasm:upload-r2) — S3-compatible API; use when dashboard upload is capped
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_WASM_BUCKET=docxform-assets
# Optional: override endpoint (default https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# Optional: upload only these comma-separated filenames (e.g. after uploading small files in UI)
# R2_UPLOAD_ONLY=soffice.wasm,soffice.data

